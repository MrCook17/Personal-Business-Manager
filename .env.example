# Local development/test configuration.
# Copy this file to .env and replace the password placeholders.
# The application and integration tests load the repository-root .env file.

PBM_CONNECTION_STRING="Server=127.0.0.1;Port=3306;Database=personal_business_manager_test;User ID=personal_business_test_app;Password=<runtime-password>;SslMode=None;Connection Timeout=5;Default Command Timeout=30;"
PBM_TEST_CONNECTION_STRING="Server=127.0.0.1;Port=3306;Database=personal_business_manager_test;User ID=personal_business_test_app;Password=<runtime-password>;SslMode=None;Connection Timeout=5;Default Command Timeout=30;"
PBM_TEST_MIGRATION_CONNECTION_STRING="Server=127.0.0.1;Port=3306;Database=personal_business_manager_test;User ID=personal_business_test_migrator;Password=<migration-password>;SslMode=None;Allow User Variables=true;Connection Timeout=5;Default Command Timeout=30;"
